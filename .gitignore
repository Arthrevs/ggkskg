# ─────────────────────────────────────────────
# SIH_2026 — .gitignore
# ─────────────────────────────────────────────

# ───── Agent Rules ─────
AGENTS.md

# ───── Node / Frontend ─────
node_modules/
dist/
build/
.next/
out/
.nuxt/
.output/
.cache/
*.tsbuildinfo

# ───── Python / Backend ─────
__pycache__/
*.py[cod]
*$py.class
*.so
.venv/
venv/
env/
.Python
*.egg-info/
*.egg
pip-log.txt
pip-delete-this-directory.txt

# ───── Environment Variables ─────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*

# ───── IDE / Editor ─────
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# ───── OS Files ─────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ───── Logs ─────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ───── Test / Coverage ─────
coverage/
.nyc_output/
htmlcov/
.pytest_cache/
.coverage
.coverage.*

# ───── Build Artifacts ─────
*.dll
*.exe
*.o
*.obj
*.dylib

# ───── Large Data Files ─────
backend/data/*.json
backend/data/*.geojson
backend/data/osm_cache/*.json
railways-master/**/*.json
